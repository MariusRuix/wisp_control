APP_NAME="Control de Servicio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City
APP_URL=http://wisp-cortes.test
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Laragon: MySQL root sin contraseña. migrate ofrece crear la BD si no existe.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wisp_cortes
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=database

# SmartOLT (nunca subir a git)
SMARTOLT_SUBDOMAIN=tuempresa
SMARTOLT_TOKEN=
SMARTOLT_TIMEOUT=30
SMARTOLT_BULK_FIELD=onus_external_ids

# Agrega esto a tu .env (no lo subas a git)
APP_NAME="Control de Servicio"

SMARTOLT_SUBDOMAIN=tuempresa
SMARTOLT_TOKEN=pega_aqui_tu_api_key
SMARTOLT_TIMEOUT=30
# Campo que espera bulk_enable/bulk_disable (ajústalo si tu cuenta usa otro)
SMARTOLT_BULK_FIELD=onus_external_ids

QUEUE_CONNECTION=database
